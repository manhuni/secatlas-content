    "c11f4666d7fcc3c6d296915b79f10991127859ec89683c323b568da1e9301733": [
      {
        "forms": [
          "Isolation",
          "psy_isolation"
        ],
        "id": "lex.sa.mind.psy_isolation",
        "kind": "lexeme",
        "language": "en",
        "lemma": "Isolation",
        "pos": "noun",
        "revision": 1,
        "senseIds": [
          "sns.sa.mind.psy_isolation.alt",
          "sns.sa.mind.psy_isolation.alt.ja",
          "sns.sa.mind.psy_isolation.alt.ko",
          "sns.sa.mind.psy_isolation.alt.pt_br",
          "sns.sa.mind.psy_isolation.alt.id",
          "sns.sa.mind.psy_isolation.alt.th",
          "sns.sa.mind.psy_isolation.alt.tr"
        ]
      },
      {
        "definition": "The slow removal of the people who would tell a person the truth, one person at a time.",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1"
        ],
        "gloss": "The slow removal of the people who would tell a person the truth, one person at a time.",
        "id": "sns.sa.mind.psy_isolation.alt",
        "kind": "sense",
        "language": "en",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "自分の言うことの是非を指摘してくれる人を、ゆっくりと一人ずつ周りから排除していくこと。拒まれるのではなく次第に呼ばれなくなる形で進む。",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1.ja"
        ],
        "gloss": "真相をerce人のPARTnersを一人ずつ静かに遠ざけること。",
        "id": "sns.sa.mind.psy_isolation.alt.ja",
        "kind": "sense",
        "language": "ja",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "자신을openh truthful하게 대할 사람들을 차례로 관계에서 배제하여 혼자 둔다.",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1.ko"
        ],
        "gloss": "진실을 말해 줄 사람들을 하나씩 천천히 멀리하게 되는 고립.",
        "id": "sns.sa.mind.psy_isolation.alt.ko",
        "kind": "sense",
        "language": "ko",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "Remoção progressiva das pessoas da vida de alguém, de modo que ele fique sem apoio e sem quem confirme os fatos. Não se refere ao simples fato de estar sozinho, mas ao isolamento que pode ser imposto deliberadamente.",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1.pt_br"
        ],
        "gloss": "Afastamento gradual das pessoas que poderiam dizer a verdade a alguém.",
        "id": "sns.sa.mind.psy_isolation.alt.pt_br",
        "kind": "sense",
        "language": "pt_br",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "Pemisahan yang dilakukan secara bertahap dengan mengeluarkan orang-orang yang dekat dengan korban satu per satu. Tujuannya membuat korban tidak memiliki siapa pun yang dapat memberi tahu kebenaran.",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1.id"
        ],
        "gloss": "Proses perlahan menjauhkan seseorang dari orang-orang yang dapat memberi tahu kebenaran.",
        "id": "sns.sa.mind.psy_isolation.alt.id",
        "kind": "sense",
        "language": "id",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "การแยกบุคคลออกจากคนอื่นอย่างค่อยเป็นค่อยไป โดยเฉพาะการทำให้เขาห่างเหินจากผู้ที่จะบอกความจริงหรือเตือนเรื่องไม่ดี",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1.th"
        ],
        "gloss": "การตัดคนที่จะบอกความจริงออกจากชีวิตทีละคน",
        "id": "sns.sa.mind.psy_isolation.alt.th",
        "kind": "sense",
        "language": "th",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "Bir kişinin çevresindeki destek ve doğruluk sağlayacak bağlantıların zamanla azaltılması. Böylece kişi, kendisine gerçeği söyleyebilecek biri kalmadığını düşünür.",
        "exampleIds": [
          "exm.sa.mind.psy_isolation.1.1.tr"
        ],
        "gloss": "Yalnızlaştırma: Gerçeği söyleyecek kişilerin birer birer uzaklaştırılmasıyla ortaya çıkan izolasyon.",
        "id": "sns.sa.mind.psy_isolation.alt.tr",
        "kind": "sense",
        "language": "tr",
        "lexemeId": "lex.sa.mind.psy_isolation",
        "pos": "noun",
        "revision": 1
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1.tr",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "Yalnızlaştırma sessizce gerçekleşti: arkadaşları birer birer davet edilmeyi bıraktı.",
        "translationLanguage": "tr"
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1.th",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "การตัดคนใกล้ชิดออกทีละคนเกิดขึ้นอย่างเงียบ ๆ เพราะเพื่อน ๆ เริ่มไม่ได้รับเชิญไปร่วมงานทีละคน",
        "translationLanguage": "th"
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1.id",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "Isolation berlangsung perlahan ketika teman-temannya mulai tidak diundang satu per satu.",
        "translationLanguage": "id"
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1.pt_br",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "O isolamento foi silencioso: aos poucos, seus amigos deixaram de ser convidados.",
        "translationLanguage": "pt_br"
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1.ko",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "그녀의 친구들은 하나씩 초대 대상에서 빠지면서 조용한 고립이 시작되었다.",
        "translationLanguage": "ko"
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1.ja",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "孤立は静かに進んでいた。友達は一人ずつ誘われなくなり、彼女の声が届くのは担当者だけだった。",
        "translationLanguage": "ja"
      },
      {
        "id": "exm.sa.mind.psy_isolation.1.1",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "The isolation was quiet: her friends stopped being invited, one by one.",
        "translation": "",
        "translationLanguage": "vi"
      }
