          "sns.sa.technology.aiw_token.alt.th",
          "sns.sa.technology.aiw_token.alt.tr"
        ]
      },
      {
        "definition": "A piece of text that the model reads and writes as one unit. Usually a word, part of a word, or a common symbol.",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1"
        ],
        "gloss": "A piece of text that the model reads and writes as one unit. Usually a word, part of a word, or a common symbol.",
        "id": "sns.sa.technology.aiw_token.alt",
        "kind": "sense",
        "language": "en",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "モデルが文章を処理する一つの単位。通常は、単語、単語の一部、またはよく使われる記号である。",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1.ja"
        ],
        "gloss": "モデルが読み書きする文章の最小単位。",
        "id": "sns.sa.technology.aiw_token.alt.ja",
        "kind": "sense",
        "language": "ja",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "보통 단어 하나, 단어의 일부, 또는 자주 쓰이는 기호에 해당합니다. 사람이 세는 글자 수나 단어 수와 반드시 일치하지는 않습니다.",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1.ko"
        ],
        "gloss": "인공지능 모델이 읽고 쓸 때 하나의 단위로 취급하는 글의 조각입니다.",
        "id": "sns.sa.technology.aiw_token.alt.ko",
        "kind": "sense",
        "language": "ko",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "Em geral, é uma palavra, parte de uma palavra ou um símbolo frequente. A mesma palavra pode ser dividida em mais de um token.",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1.pt_br"
        ],
        "gloss": "Token é uma unidade de texto que o modelo lê e escreve.",
        "id": "sns.sa.technology.aiw_token.alt.pt_br",
        "kind": "sense",
        "language": "pt_br",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "Token biasanya berupa kata, bagian dari kata, atau simbol yang umum. Model memproses teks sebagai rangkaian token, bukan sebagai rangkaian karakter.",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1.id"
        ],
        "gloss": "Token adalah satuan teks yang dibaca dan ditulis model.",
        "id": "sns.sa.technology.aiw_token.alt.id",
        "kind": "sense",
        "language": "id",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "โทเคนคือหน่วยข้อความที่โมเดลใช้ประมวลผล มักเป็นคำ ส่วนของคำ หรือสัญลักษณ์ที่พบบ่อย แต่ไม่จำเป็นต้องตรงกับคำหรืออักขระหนึ่งหน่วยเสมอไป",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1.th"
        ],
        "gloss": "หน่วยข้อความที่โมเดลอ่านและเขียนเป็นชิ้นเดียว",
        "id": "sns.sa.technology.aiw_token.alt.th",
        "kind": "sense",
        "language": "th",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "definition": "Genellikle bir sözcük, sözcüğün bir bölümü veya yaygın bir simgedir. Model, metni bu birimler hâlinde işler; her sözcük mutlaka tek bir belirtece karşılık gelmez.",
        "exampleIds": [
          "exm.sa.technology.aiw_token.1.1.tr"
        ],
        "gloss": "Modelin tek birim olarak okuyup yazdığı metin parçasıdır.",
        "id": "sns.sa.technology.aiw_token.alt.tr",
        "kind": "sense",
        "language": "tr",
        "lexemeId": "lex.sa.technology.aiw_token",
        "pos": "noun",
        "revision": 1
      },
      {
        "id": "exm.sa.technology.aiw_token.1.1.tr",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "\"Pompa\" sözcüğü tek bir belirteç olabilir, olağan dışı bir parça numarası ise üç belirteç olabilir.",
        "translationLanguage": "tr"
      },
      {
        "id": "exm.sa.technology.aiw_token.1.1.th",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "คำว่า “ปั๊ม” อาจเป็นหนึ่งโทเคน ส่วนหมายเลขชิ้นส่วนที่พบไม่บ่อยอาจต้องใช้สามโทเคน",
        "translationLanguage": "th"
      },
      {
        "id": "exm.sa.technology.aiw_token.1.1.id",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "Kata \"pompa\" dapat menjadi satu token, sedangkan nomor seri yang tidak lazim mungkin terdiri atas tiga token.",
        "translationLanguage": "id"
      },
      {
        "id": "exm.sa.technology.aiw_token.1.1.pt_br",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "A palavra \"pump\" pode formar um único token, enquanto um número de peça incomum pode ocupar três.",
        "translationLanguage": "pt_br"
      },
      {
        "id": "exm.sa.technology.aiw_token.1.1.ko",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "‘펌프processor라는 단어는 한 토큰일 수도 있고, 드문 부호 하나가 여러 토큰일 수도 있습니다.",
        "translationLanguage": "ko"
      },
      {
        "id": "exm.sa.technology.aiw_token.1.1.ja",
        "kind": "example",
        "revision": 1,
        "sourceLanguage": "en",
        "text": "",
        "translation": "「这是个」は1トークンになるが、aleeな製品番号は3トークンになることがある。",
        "translationLanguage": "ja"
      },
