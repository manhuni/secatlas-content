        "language": "en",
        "lemma": "Token",
        "pos": "noun",
        "revision": 1,
        "senseIds": [
          "sns.sa.technology.aiw_token.alt",
          "sns.sa.technology.aiw_token.alt.ja",
          "sns.sa.technology.aiw_token.alt.ko",
          "sns.sa.technology.aiw_token.alt.pt_br",
